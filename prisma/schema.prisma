  pxxh           Int?
  pk_station     String?  @db.VarChar(36)
  pk_Customer    String?  @db.VarChar(36)
  pk_recipe      String?  @db.VarChar(36)
  qty            Decimal? @db.Decimal(18, 4)
  qty_now        Decimal? @db.Decimal(18, 4)
  price          Decimal? @db.Decimal(18, 4)
  oper_date      DateTime?
  remark         String?  @db.VarChar(255)
  oper           String?  @db.VarChar(255)
  acode          String?  @db.VarChar(50)
  status         Int?
  lqprojectname1 String?  @db.VarChar(255)
  qty_che        Int?
  zbv1           String?  @db.VarChar(255)
  zbv2           String?  @db.VarChar(255)
  zbv3           String?  @db.VarChar(255)
  zbf1           Decimal? @db.Decimal(18, 4)
  zbf2           Decimal? @db.Decimal(18, 4)
  zbf3           Decimal? @db.Decimal(18, 4)
  zbi1           Int?
  zbi2           Int?
  zbi3           Int?
  zbb1           Boolean?
  zbb2           Boolean?
  zbb3           Boolean?
  bautobell      Boolean?
  ProjectCmpy    String?  @db.VarChar(255)
  ProjectPart    String?  @db.VarChar(100)
  tld            String?  @db.VarChar(45)
  WorkPart       String?  @db.VarChar(100)
  shipper        String?  @db.VarChar(50)
  water_adj      Decimal?     @db.Decimal(4, 0)
  WorkMethod     String?  @db.VarChar(100)
}

model xscustomer {
  pk            String   @id @db.VarChar(36)
  pxxh          Int?
  pk_station    String?  @db.VarChar(36)
  title         String?  @db.VarChar(255)
  addr          String?  @db.VarChar(255)
  addr_distance Decimal? @db.Decimal(18, 4)
  telphone      String?  @db.VarChar(255)
  email         String?  @db.VarChar(50)
  recipe_last   String?  @db.VarChar(36)
  driver_last   String?  @db.VarChar(50)
  truck_last    String?  @db.VarChar(50)
  sale_last     DateTime?
  oper_date     DateTime?
  remark        String?  @db.VarChar(255)
  oper          String?  @db.VarChar(255)
  status        Int?
}

